<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Active_Requires_MRR</fullName>
    <active>true</active>
    <errorConditionFormula>AND( ISPICKVAL(Status__c, &quot;Active&quot;), OR( ISBLANK(MRR__c), MRR__c &lt;= 0 ) )</errorConditionFormula>
    <errorDisplayField>MRR__c</errorDisplayField>
    <errorMessage>An active subscription must have an MRR greater than zero.</errorMessage>
</ValidationRule>
