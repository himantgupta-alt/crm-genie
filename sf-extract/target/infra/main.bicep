// CRM Genie: the Subscription domain compiled out of Salesforce, hosted in Azure.
// Same conventions as Cash Forecasting in this resource group: ${baseName}-<type>-${instance}, tags on everything,
// nothing shared with other apps (Revenue Genie, Cash Forecasting).
//
//   az deployment group create -g AZAP-agentic-finance -f main.bicep -p pgAdminPassword=<secret> ...
// Run through deploy.ps1, which keeps secrets out of the command history and re-applies settings.

@description('Azure region; defaults to the resource group location (centralindia for AZAP-agentic-finance).')
param location string = resourceGroup().location

@description('Base name for every resource.')
param baseName string = 'crmgenie'

@description('Suffix that keeps names globally unique; hg01 follows the existing revgenie-*-hg01 and cashflow-*-hg01 convention.')
param instance string = 'hg01'

@allowed([ 'B1', 'B2', 'P0v3' ])
param appSku string = 'B1'

@description('Postgres administrator login used by the app and the loader.')
param pgAdminLogin string = 'crmadmin'

@secure()
@description('Postgres administrator password. Generated by deploy.ps1 and kept in .secrets/, never in source.')
param pgAdminPassword string

@description('Salesforce org URL, for "Open in Salesforce" links on every record page.')
param sfInstanceUrl string = ''

@description('Public IP of the machine that runs the loader; empty to skip the firewall rule.')
param deployerIp string = ''

@secure()
@description('Client secret of the Entra app registration used by App Service authentication. Empty until deploy_auth.ps1 has run.')
param authClientSecret string = ''

param tags object = {
  owner: 'Demo User'
  project: 'CRM Genie'
  app: 'crmgenie'
  env: 'dev'
  managedBy: 'Bicep'
  source: 'Salesforce org compiled by Org Compiler'
}

var planName = '${baseName}-app-plan'
var siteName = '${baseName}-app-${instance}'
var pgName = '${baseName}-pg-${instance}'
var dbName = 'crm'

// ---------------------------------------------------------------- database

resource pg 'Microsoft.DBforPostgreSQL/flexibleServers@2024-08-01' = {
  name: pgName
  location: location
  tags: tags
  sku: {
    name: 'Standard_B1ms'
    tier: 'Burstable'
  }
  properties: {
    version: '17'
    administratorLogin: pgAdminLogin
    administratorLoginPassword: pgAdminPassword
    authConfig: {
      passwordAuth: 'Enabled'
      activeDirectoryAuth: 'Disabled'
    }
    storage: {
      storageSizeGB: 32
      autoGrow: 'Enabled'
    }
    backup: {
      backupRetentionDays: 7
      geoRedundantBackup: 'Disabled'
    }
    highAvailability: {
      mode: 'Disabled'
    }
    network: {
      publicNetworkAccess: 'Enabled'
    }
  }
}

resource db 'Microsoft.DBforPostgreSQL/flexibleServers/databases@2024-08-01' = {
  parent: pg
  name: dbName
  properties: {
    charset: 'UTF8'
    collation: 'en_US.utf8'
  }
}

// App Service reaches Postgres over the Azure backbone (0.0.0.0 = "allow Azure services").
resource fwAzure 'Microsoft.DBforPostgreSQL/flexibleServers/firewallRules@2024-08-01' = {
  parent: pg
  name: 'AllowAllAzureServices'
  properties: {
    startIpAddress: '0.0.0.0'
    endIpAddress: '0.0.0.0'
  }
}

resource fwDeployer 'Microsoft.DBforPostgreSQL/flexibleServers/firewallRules@2024-08-01' = if (!empty(deployerIp)) {
  parent: pg
  name: 'deployer'
  properties: {
    startIpAddress: deployerIp
    endIpAddress: deployerIp
  }
}

// ---------------------------------------------------------------- web app

resource plan 'Microsoft.Web/serverfarms@2023-12-01' = {
  name: planName
  location: location
  tags: tags
  kind: 'linux'
  sku: {
    name: appSku
    capacity: 1
  }
  properties: {
    reserved: true
  }
}

var baseSettings = [
  { name: 'PGHOST', value: pg.properties.fullyQualifiedDomainName }
  { name: 'PGDATABASE', value: dbName }
  { name: 'PGUSER', value: pgAdminLogin }
  { name: 'PGPASSWORD', value: pgAdminPassword }
  { name: 'PGSSLMODE', value: 'require' }
  { name: 'SF_INSTANCE_URL', value: sfInstanceUrl }
  { name: 'NODE_ENV', value: 'production' }
  // The deployment package already contains node_modules; no build on the server.
  { name: 'SCM_DO_BUILD_DURING_DEPLOYMENT', value: 'false' }
  { name: 'WEBSITE_RUN_FROM_PACKAGE', value: '1' }
]
// Bicep replaces all app settings on every deploy, so the auth secret is passed back in each time.
var authSettings = empty(authClientSecret) ? [] : [
  { name: 'MICROSOFT_PROVIDER_AUTHENTICATION_SECRET', value: authClientSecret }
]

resource site 'Microsoft.Web/sites@2023-12-01' = {
  name: siteName
  location: location
  tags: tags
  kind: 'app,linux'
  identity: {
    type: 'SystemAssigned'
  }
  properties: {
    serverFarmId: plan.id
    httpsOnly: true
    siteConfig: {
      linuxFxVersion: 'NODE|22-lts'
      appCommandLine: 'node server.js'
      alwaysOn: true
      ftpsState: 'Disabled'
      minTlsVersion: '1.2'
      http20Enabled: true
      healthCheckPath: '/health'
      appSettings: concat(baseSettings, authSettings)
    }
  }
}

// GitHub Actions deploys with the site's publish profile, which needs SCM basic auth on this app only.
resource scmPolicy 'Microsoft.Web/sites/basicPublishingCredentialsPolicies@2023-12-01' = {
  parent: site
  name: 'scm'
  properties: {
    allow: true
  }
}

output siteName string = site.name
output siteUrl string = 'https://${site.properties.defaultHostName}'
output pgServer string = pg.properties.fullyQualifiedDomainName
output pgDatabase string = dbName
