<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>No_Reactivation_After_Cancel</fullName>
    <active>true</active>
    <errorConditionFormula>AND( ISCHANGED(Status__c), ISPICKVAL(PRIORVALUE(Status__c), &quot;Cancelled&quot;), NOT(ISPICKVAL(Status__c, &quot;Cancelled&quot;)) )</errorConditionFormula>
    <errorDisplayField>Status__c</errorDisplayField>
    <errorMessage>A cancelled subscription cannot be reactivated. Create a new subscription instead.</errorMessage>
</ValidationRule>
