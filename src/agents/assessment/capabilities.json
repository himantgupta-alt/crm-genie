{
  "description": "Business capabilities the Assessment agent recognises in a consumer-goods sales org, the standard Salesforce feature that covers each one, and the default verdict. A component (custom object, custom field on a standard object, Apex class or trigger, installed package) belongs to the first capability whose pattern matches its name; Apex code that matches no name pattern belongs to the capability of the objects it reads or writes. Anything left over goes to the workshop list. Dispositions (as in the proposal): adopt (a standard Salesforce or Consumer Goods Cloud feature covers it), configure (replace custom code with supported configuration), retain (valuable, supportable differentiation with no standard equivalent), harmonise (the same need is built differently in several orgs: align the pattern while keeping the orgs separate), retire (unused, duplicated or obsolete), review (purpose, regulatory context, usage or licensing to confirm).",
  "verdicts": {
    "adopt": "Adopt standard",
    "configure": "Replace with configuration",
    "retain": "Retain",
    "harmonise": "Harmonise",
    "retire": "Retire",
    "review": "Review with business"
  },
  "capabilities": [
    {
      "id": "store-visits",
      "area": "Retail execution",
      "capability": "Store visits",
      "match": {
        "objects": "^(Store|Outlet|Field|Retail)_?Visit__c$",
        "classes": "^(Store|Outlet|Field)Visit\\w*$"
      },
      "verdict": "adopt",
      "standard": "Consumer Goods Cloud: Visit and Retail Store, with visit tasks on the mobile app",
      "licence": "Consumer Goods Cloud",
      "reference": "Salesforce Help: Consumer Goods Cloud, Retail Execution",
      "subprocesses": [
        {
          "id": "visit-scheduling",
          "name": "Visit scheduling",
          "match": {
            "objects": "^(Store|Outlet|Field|Retail)_?Visit__c$",
            "fields": "^(Store|Outlet|Field|Retail)_?Visit__c\\.(Visit_Date|Visit_Type|Status|Notes|Account|Beat_Plan)__c$"
          }
        },
        {
          "id": "check-in",
          "name": "Check-in at the store",
          "match": {
            "fields": "^(Store|Outlet|Field|Retail)_?Visit__c\\.(Checked_In|Check_In_\\w+|GPS_\\w+)__c$",
            "methods": "\\.(requireCheckIn|stampCheckIn|checkIn\\w*)$"
          }
        },
        {
          "id": "visit-outcome",
          "name": "Visit outcome and alerts",
          "match": {
            "fields": "^(Store|Outlet|Field|Retail)_?Visit__c\\.(Out_Of_Stocks|Compliance_Pct|Planogram_OK|Shelf_Checks)__c$",
            "methods": "\\.(alertAreaManager|countOutOfStocks|\\w*Alert\\w*)$"
          }
        }
      ]
    },
    {
      "id": "visit-tasks",
      "area": "Retail execution",
      "capability": "Visit tasks",
      "match": {
        "objects": "^(Visit_Task|Visit_Activity|Visit_Action)__c$"
      },
      "verdict": "adopt",
      "standard": "Consumer Goods Cloud: action plan templates create the tasks of each visit (assessment, inventory and price checks)",
      "licence": "Consumer Goods Cloud",
      "reference": "Salesforce Help: Consumer Goods Cloud, action plan templates",
      "subprocesses": [
        {
          "id": "task-generation",
          "name": "Task generation",
          "match": {
            "objects": "^(Visit_Task|Visit_Activity|Visit_Action)__c$",
            "methods": "\\.(create\\w*Tasks?|generate\\w*Tasks?)$"
          }
        },
        {
          "id": "task-completion",
          "name": "Task completion",
          "match": {
            "fields": "^(Visit_Task|Visit_Activity|Visit_Action)__c\\.(Done|Result|Completed\\w*)__c$"
          }
        }
      ]
    },
    {
      "id": "in-store-audit",
      "area": "Retail execution",
      "capability": "Shelf checks and in-store audits",
      "match": {
        "objects": "^(Shelf_Check|Outlet_Audit|Store_Audit|Store_Check)__c$"
      },
      "verdict": "adopt",
      "standard": "Consumer Goods Cloud: assessment tasks and retail store KPIs recorded during a visit",
      "licence": "Consumer Goods Cloud",
      "reference": "Salesforce Help: Consumer Goods Cloud, Retail Execution (assessment tasks, KPIs)",
      "subprocesses": [
        {
          "id": "availability-check",
          "name": "Shelf availability check",
          "match": {
            "objects": "^(Shelf_Check|Outlet_Audit|Store_Audit|Store_Check)__c$",
            "fields": "^(Shelf_Check|Outlet_Audit|Store_Audit|Store_Check)__c\\.(On_Shelf|Available|Facings|Product)__c$"
          }
        },
        {
          "id": "price-check",
          "name": "Price check",
          "match": {
            "fields": "^(Shelf_Check|Outlet_Audit|Store_Audit|Store_Check)__c\\.(Shelf_Price|Price_Observed)__c$"
          }
        }
      ]
    },
    {
      "id": "cg-extensions",
      "area": "Retail execution",
      "capability": "Extensions to Consumer Goods Cloud objects",
      "generic": true,
      "match": {
        "fields": "^(Visit|RetailStore|RetailVisitKpi|AssessmentTask|RetailStoreGroup|InStoreLocation|StoreProduct)\\.",
        "triggers": "^(Visit|RetailStore|RetailVisitKpi)\\w*Trigger$"
      },
      "verdict": "retain",
      "standard": "Fields and automation added to standard Consumer Goods Cloud objects: the standard object is used and extended",
      "licence": "Consumer Goods Cloud",
      "reference": "Salesforce Help: Consumer Goods Cloud, Retail Execution"
    },
    {
      "id": "visit-planning",
      "area": "Retail execution",
      "capability": "Visit planning and routes",
      "match": {
        "objects": "^(Beat_Plan|Beat_Plan_Outlet|Route_Plan|Journey_Plan)(_\\w+)?__c$"
      },
      "verdict": "adopt",
      "standard": "Consumer Goods Cloud: visit planning with retail store groups and action plan templates",
      "licence": "Consumer Goods Cloud",
      "reference": "Salesforce Help: Consumer Goods Cloud, visit planning",
      "subprocesses": [
        {
          "id": "route-planning",
          "name": "Route and sequence planning",
          "match": {
            "objects": "^(Beat_Plan|Route_Plan|Journey_Plan)__c$",
            "fields": "^(Beat_Plan|Route_Plan|Journey_Plan)(_\\w+)?__c\\.(Day_Of_Week|Territory|Sequence)__c$"
          }
        },
        {
          "id": "outlet-selection",
          "name": "Territory and outlet selection",
          "match": {
            "objects": "^(Beat_Plan|Route_Plan|Journey_Plan)_(Outlet|Store)__c$"
          }
        }
      ]
    },
    {
      "id": "assortment",
      "area": "Retail execution",
      "capability": "Store assortment and must-stock lists",
      "match": {
        "objects": "^(Store_Assortment|Must_Stock_List|Assortment\\w*)__c$"
      },
      "verdict": "adopt",
      "standard": "Consumer Goods Cloud: product assortments assigned to retail store groups",
      "licence": "Consumer Goods Cloud",
      "reference": "Salesforce Help: Consumer Goods Cloud, product assortments",
      "subprocesses": [
        {
          "id": "must-stock",
          "name": "Must-stock lists",
          "match": {
            "objects": "^(Store_Assortment|Must_Stock_List|Assortment\\w*)__c$"
          }
        }
      ]
    },
    {
      "id": "trade-promotions",
      "area": "Trade promotion management (TPM)",
      "capability": "Trade promotions and deals",
      "match": {
        "objects": "^(Trade_Promotion|Trade_Deal|Promotion_Product|Promotion_Line)__c$",
        "classes": "^TradePromotionService$"
      },
      "verdict": "adopt",
      "standard": "Consumer Goods Cloud Trade Promotion Management: promotion planning, funds and post-event analysis",
      "licence": "Trade Promotion Management (add-on)",
      "reference": "Salesforce Help: Consumer Goods Cloud, Trade Promotion Management",
      "subprocesses": [
        {
          "id": "promo-planning",
          "name": "Promotion planning",
          "match": {
            "objects": "^(Trade_Promotion|Trade_Deal|Promotion_Product|Promotion_Line)__c$",
            "fields": "^(Trade_Promotion|Trade_Deal)__c\\.(Mechanic|Budget|Start_Date|End_Date|Uplift_Pct|Discount_Pct|Funding|Account|Status)__c$",
            "rules": "^(Trade_Promotion|Trade_Deal)__c\\."
          }
        },
        {
          "id": "post-event",
          "name": "Post-event analysis",
          "match": {
            "fields": "^(Trade_Promotion|Trade_Deal)__c\\.(Baseline_Volume|Actual_Volume|Actual_Spend|ROI)__c$",
            "methods": "\\.(calculateResults|\\w*ROI\\w*|\\w*PostEvent\\w*)$"
          }
        },
        {
          "id": "promo-notifications",
          "name": "Promotion notifications",
          "match": {
            "methods": "^(TradePromotion|TradeDeal)\\w*\\.(post\\w*|email\\w*|notify\\w*)$"
          }
        },
        {
          "id": "erp-handoff",
          "name": "ERP hand-off",
          "match": {
            "fields": "^(Trade_Promotion|Trade_Deal)__c\\.ERP_\\w+__c$",
            "methods": "^(TradePromotion|TradeDeal)\\w*\\.\\w*(Erp|ERP)\\w*$"
          }
        }
      ]
    },
    {
      "id": "trade-funds",
      "area": "Trade promotion management (TPM)",
      "capability": "Trade funds",
      "match": {
        "objects": "^(Trade_Fund|Promotion_Fund|Fund)__c$"
      },
      "verdict": "adopt",
      "standard": "Trade Promotion Management: funds with allocated, committed and spent amounts kept by the platform",
      "licence": "Trade Promotion Management (add-on)",
      "reference": "Salesforce Help: Trade Promotion Management, funds",
      "subprocesses": [
        {
          "id": "fund-allocation",
          "name": "Fund allocation",
          "match": {
            "objects": "^(Trade_Fund|Promotion_Fund|Fund)__c$",
            "fields": "^(Trade_Fund|Promotion_Fund|Fund)__c\\.(Amount|Fund_Type|Year|Account|Status)__c$",
            "rules": "^(Trade_Fund|Promotion_Fund|Fund)__c\\."
          }
        },
        {
          "id": "fund-commitment",
          "name": "Fund commitment and checks",
          "match": {
            "fields": "^(Trade_Fund|Promotion_Fund|Fund)__c\\.Committed__c$|__c\\.(Trade_Fund|Fund)__c$",
            "methods": "\\.(check\\w*Fund\\w*|update\\w*Fund\\w*|\\w*Fund\\w*)$"
          }
        }
      ]
    },
    {
      "id": "claims",
      "area": "Trade promotion management (TPM)",
      "capability": "Distributor and customer claims",
      "match": {
        "objects": "^(Distributor_Claim|Customer_Claim|Promotion_Claim|Claim)__c$",
        "classes": "^(Distributor|Promotion)Claim\\w*$"
      },
      "verdict": "adopt",
      "standard": "Trade Promotion Management: claims and payments checked against promotion funds",
      "licence": "Trade Promotion Management (add-on)",
      "reference": "Salesforce Help: Trade Promotion Management, claims",
      "subprocesses": [
        {
          "id": "claim-capture",
          "name": "Claim capture",
          "match": {
            "objects": "^(Distributor_Claim|Customer_Claim|Promotion_Claim|Claim)__c$",
            "fields": "^(Distributor_Claim|Customer_Claim|Promotion_Claim|Claim)__c\\.(Invoice_Number|Claim_Amount|Distributor|Account|Trade_Promotion)__c$",
            "rules": "^(Distributor_Claim|Customer_Claim|Promotion_Claim|Claim)__c\\."
          }
        },
        {
          "id": "claim-validation",
          "name": "Claim validation and approval",
          "match": {
            "methods": "Claim\\w*\\.(check\\w*|autoApprove\\w*|\\w*Budget\\w*|\\w*Approve\\w*)$",
            "fields": "^(Distributor_Claim|Customer_Claim|Promotion_Claim|Claim)__c\\.Status__c$"
          }
        }
      ]
    },
    {
      "id": "promotion-approval",
      "area": "Trade promotion management (TPM)",
      "capability": "Promotion approval",
      "match": {
        "classes": "^TradePromotionApproval$"
      },
      "verdict": "configure",
      "standard": "Approval processes or Flow approval orchestration, with the threshold held as configuration",
      "licence": "Sales Cloud",
      "reference": "Salesforce Help: Approval processes; Flow approval orchestration",
      "subprocesses": [
        {
          "id": "approval-routing",
          "name": "Approval routing",
          "match": {
            "methods": "^(TradePromotion|TradeDeal)Approval\\w*\\."
          }
        }
      ]
    },
    {
      "id": "orders",
      "area": "Order to cash",
      "capability": "Order capture",
      "match": {
        "objects": "^Order_Request(_Line)?__c$"
      },
      "verdict": "adopt",
      "standard": "Standard Order and Order Product, with order totals kept by the platform",
      "licence": "Sales Cloud",
      "reference": "Salesforce Help: Orders"
    },
    {
      "id": "order-totals",
      "area": "Order to cash",
      "capability": "Order totals",
      "match": {
        "classes": "^OrderRequestService$",
        "triggers": "^OrderRequestLineTrigger$"
      },
      "verdict": "configure",
      "standard": "Roll-up summary field (or the standard Order total) instead of trigger code",
      "licence": "Sales Cloud",
      "reference": "Salesforce Help: Roll-up summary fields"
    },
    {
      "id": "credit-check",
      "area": "Order to cash",
      "capability": "Credit check with the ERP",
      "match": {
        "classes": "^ErpCredit\\w*$",
        "fields": "^Account\\.(Credit_Limit|Credit_Status)__c$"
      },
      "verdict": "retain",
      "standard": "No standard equivalent: keep one integration, called through the integration layer with a named credential",
      "licence": "",
      "reference": "Salesforce Help: Named credentials"
    },
    {
      "id": "distributor-stock",
      "area": "Order to cash",
      "capability": "Distributor stock reporting",
      "match": {
        "objects": "^Distributor_Stock__c$"
      },
      "verdict": "retain",
      "standard": "No standard equivalent in Consumer Goods Cloud: keep one global object and load it from distributor feeds",
      "licence": "",
      "reference": ""
    },
    {
      "id": "targets",
      "area": "Sales performance",
      "capability": "Sales targets",
      "match": {
        "objects": "^(Sales_Target|Target|Quota)__c$"
      },
      "verdict": "configure",
      "standard": "Collaborative Forecasts with quotas by user, territory or product family",
      "licence": "Sales Cloud",
      "reference": "Salesforce Help: Collaborative Forecasts, quotas"
    },
    {
      "id": "market",
      "area": "Customer master",
      "capability": "Market and channel segmentation",
      "match": {
        "fields": "^Account\\.(Market|Customer_Channel|Customer_Tier|Store_Format)__c$"
      },
      "verdict": "configure",
      "standard": "Global value sets shared by all orgs, with Enterprise Territory Management for market ownership",
      "licence": "Sales Cloud",
      "reference": "Salesforce Help: Global value sets; Enterprise Territory Management"
    },
    {
      "id": "tax-id",
      "area": "Customer master",
      "capability": "Customer tax registration",
      "match": {
        "fields": "^Account\\.(VAT_Number|GST_Number|Tax_ID|Tax_Number)__c$"
      },
      "verdict": "retain",
      "standard": "No standard tax ID field on Account: keep one global field with per-market format rules",
      "licence": "",
      "reference": ""
    },
    {
      "id": "erp-key",
      "area": "Customer master",
      "capability": "ERP customer key",
      "match": {
        "fields": "^Account\\.(Legacy_ERP_Code|ERP_Code|ERP_Id)__c$"
      },
      "verdict": "retain",
      "standard": "Keep as an external ID field so integrations can upsert by the ERP key",
      "licence": "",
      "reference": "Salesforce Help: External ID fields"
    },
    {
      "id": "consent",
      "area": "Customer master",
      "capability": "Contact consent",
      "match": {
        "fields": "^Contact\\.(GDPR_Consent|Consent_Date|Marketing_Consent)__c$"
      },
      "verdict": "adopt",
      "standard": "Individual and contact point consent objects with data use purposes",
      "licence": "Sales Cloud",
      "reference": "Salesforce Help: Consent management (Individual, contact point consent)"
    },
    {
      "id": "product-master",
      "area": "Product master",
      "capability": "Product attributes",
      "match": {
        "fields": "^Product2\\.(Brand|Category|EAN|Case_Size)__c$"
      },
      "verdict": "retain",
      "standard": "Keep as fields on Product, owned by the product master (one definition for all orgs)",
      "licence": "",
      "reference": ""
    },
    {
      "id": "subscriptions",
      "area": "Other",
      "capability": "Subscriptions",
      "match": {
        "objects": "^Subscription(_Line)?__c$",
        "classes": "^(Subscription|Opportunity)\\w*$",
        "triggers": "^(Subscription|Opportunity)\\w*$"
      },
      "verdict": "adopt",
      "standard": "Revenue Cloud subscription management",
      "licence": "Revenue Cloud",
      "reference": "Salesforce Help: Revenue Cloud"
    },
    {
      "id": "rollup-tool",
      "area": "Platform",
      "capability": "Roll-ups between related records",
      "match": {
        "packages": "^Declarative Lookup Rollup Summaries"
      },
      "verdict": "configure",
      "standard": "Roll-up summary fields where the relationship is master-detail, record-triggered flows elsewhere",
      "licence": "",
      "reference": "Salesforce Help: Roll-up summary fields; record-triggered flows"
    },
    {
      "id": "area-tpm",
      "area": "Trade promotion management (TPM)",
      "capability": "Other trade promotion extensions",
      "match": {},
      "fallback": "(Trade_?Promo|TPM|Tactic|Trade_?Fund|Promo\\w*_?Fund|Trade_?Claim|Payment_Tactic|Sell_Sheet|KAM(?![a-z])|cgcloud__Promotion|cgcloud__Fund|cgcloud__Payment)",
      "verdict": "review",
      "standard": "Placed in this area by the objects it belongs to or uses; compare with Consumer Goods Cloud Trade Promotion Management before a verdict",
      "licence": "Consumer Goods Cloud TPM",
      "reference": "Salesforce Help: Trade Promotion Management"
    },
    {
      "id": "area-retail",
      "area": "Retail execution",
      "capability": "Other retail execution extensions",
      "match": {},
      "fallback": "(Visit(?!or)|RetailStore|Retail_Store|InStoreLocation|Store_?Visit|Outlet|Tour(?![a-z])|Trip_?List|Retail_?Audit|Store_?Audit|Planogram|Merchandis|Job_Definition|Job_List)",
      "verdict": "review",
      "standard": "Placed in this area by the objects it belongs to or uses; compare with Consumer Goods Cloud Retail Execution before a verdict",
      "licence": "Consumer Goods Cloud",
      "reference": "Salesforce Help: Consumer Goods Cloud, Retail Execution"
    },
    {
      "id": "area-order",
      "area": "Order to cash",
      "capability": "Other order to cash extensions",
      "match": {},
      "fallback": "(Order|Invoice|Payment|Pricebook|Price|Pricing|Quote|Contract|Credit|Inventory|Warehouse|Stock|Delivery|Shipment|Billing|SBQQ|blng)",
      "verdict": "review",
      "standard": "Placed in this area by the objects it belongs to or uses; compare with standard Orders, Price Books and Consumer Goods Cloud order capture before a verdict",
      "licence": "",
      "reference": "Salesforce Help: Orders; Price Books"
    },
    {
      "id": "area-product",
      "area": "Product master",
      "capability": "Other product extensions",
      "match": {},
      "fallback": "(Product|Assortment|Listing|Unit_of_Measure|Catalog|Category|Brand|SKU)",
      "verdict": "review",
      "standard": "Placed in this area by the objects it belongs to or uses; compare with standard Product and product hierarchy before a verdict",
      "licence": "",
      "reference": "Salesforce Help: Products"
    },
    {
      "id": "area-customer",
      "area": "Customer master",
      "capability": "Other customer extensions",
      "match": {},
      "fallback": "(Account|Contact|Customer|Org_Unit|Hierarchy|Address|Individual|Consent)",
      "verdict": "review",
      "standard": "Placed in this area by the objects it belongs to or uses; compare with standard Account, Contact and account hierarchy before a verdict",
      "licence": "",
      "reference": "Salesforce Help: Accounts; Contacts"
    },
    {
      "id": "area-sales",
      "area": "Sales performance",
      "capability": "Other sales extensions",
      "match": {},
      "fallback": "(Opportunity|Lead|Campaign|Target|Quota|Forecast|Territory|Sales_)",
      "verdict": "review",
      "standard": "Placed in this area by the objects it belongs to or uses; compare with standard Opportunities, Forecasts and Territory Management before a verdict",
      "licence": "",
      "reference": "Salesforce Help: Collaborative Forecasts"
    },
    {
      "id": "area-service",
      "area": "Service",
      "capability": "Service extensions",
      "match": {},
      "fallback": "(Case|WorkOrder|Work_Order|ServiceAppointment|Service_|Asset|Entitlement|FSL)",
      "verdict": "review",
      "standard": "Placed in this area by the objects it belongs to or uses; compare with standard Service Cloud and Field Service before a verdict",
      "licence": "",
