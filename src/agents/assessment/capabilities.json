  "rules": {
    "retireWhenFillBelow": 1,
    "retireObjectsWithoutRecords": true,
    "commonObjectAreas": 4,
    "mainModelShare": 0.8,
    "nameFamilyAreas": 3,
    "nameFamilyMinimum": 10
  }
}
