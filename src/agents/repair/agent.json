{
  "id": "repair",
  "name": "Repair agent",
  "phase": "validate",
  "outputDir": "adlc/5-validate/repair",
  "kb": [
    "kb/testing-standards.md",
    "kb/secure-coding.md",
    "kb/engineering-principles.md",
    "kb/salesforce-translation-playbook.md"
  ],
  "guardrails": "guardrails/guardrails.json",
  "kind": "llm",
  "runs": "on_failure",
  "role": "When verification fails, finds the root cause and proposes a fix to the generator for a reviewer to approve.",
  "inputs": [
    "adlc/5-validate/verification/report.json (failed checks)",
    "adlc/3-build/*/sql/*.sql",
    "src/generators/emit-postgres.js"
  ],
  "tools": [
    "Claude (model in AGENT_MODEL, default claude-opus-5-5)",
    "git apply (after approval)"
  ],
  "prompt": "agents/repair/prompt.md",
  "implementation": [
    "agents/repair/index.js"
  ],
  "outputs": [
    "adlc/5-validate/repair/latest-proposal.md",
    "adlc/5-validate/repair/latest-proposal.patch",
    "src/agents/runs/<run>/repair.md and repair.patch (full run record, kept local)"
  ],
  "done_when": "Root cause explained and a generator patch proposed; never applied without approval",
  "reviewer_checks": [
    "Root cause",
    "Patch limited to the generator",
    "No grant widened for user roles"
  ]
}
