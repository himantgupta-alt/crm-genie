# Portable toolchain (Node, Git, sf CLI) - reinstall per machine
tools/
# Org data export: only what the pipeline needs is versioned. The rest holds real user names and emails.
adlc/1-discover/extraction/data/*
!adlc/1-discover/extraction/data/_export-report.json
!adlc/1-discover/extraction/data/Account.csv
!adlc/1-discover/extraction/data/Contact.csv
!adlc/1-discover/extraction/data/Opportunity.csv
!adlc/1-discover/extraction/data/Product2.csv
!adlc/1-discover/extraction/data/Subscription__c.csv
!adlc/1-discover/extraction/data/Subscription_Line__c.csv
# Inventory files that list individual users
adlc/1-discover/extraction/inventory/activeUsers.json
adlc/1-discover/extraction/inventory/apiOnlyUsers.json
# Produced at run time. The parity and load reports are committed from a reference run so the console and the
# team can open the real files; CI produces them again on every run.
src/app/public/compiler.html
src/app/runtime/
# Assessment demo org builds (regenerated by src/salesforce-seed/cpg/seed-cpg.js)
src/salesforce-seed/cpg/out/
# Agent run records (prompts, responses, decisions) stay local; they can hold org data
src/agents/runs/

